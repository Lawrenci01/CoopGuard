{
  "expo": {
    "name": "CoopGuard",
    "slug": "coopguard",
    "scheme": "coopguard",
    "platforms": ["ios", "android"],
    "version": "0.7.2",
    "icon": "./assets/coopguard-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coopguard.app",
      "icon": "./assets/coopguard-logo.png"
    },
    "android": {
      "versionCode": 17,
      "package": "com.coopguard.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/coopguard-logo.png",
        "backgroundColor": "#F4F8F5"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Allow CoopGuard to scan farm hub and node QR codes." }
      ],
      "./plugins/withLocalTls"
    ]
  }
}
